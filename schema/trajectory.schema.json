{
  "$defs": {
    "Action": {
      "additionalProperties": false,
      "properties": {
        "tool": {
          "title": "Tool",
          "type": "string"
        },
        "args": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Args",
          "type": "object"
        },
        "command": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Command"
        },
        "targets": {
          "items": {
            "type": "string"
          },
          "title": "Targets",
          "type": "array"
        }
      },
      "required": [
        "tool"
      ],
      "title": "Action",
      "type": "object"
    },
    "JsonValue": {},
    "Limits": {
      "additionalProperties": false,
      "properties": {
        "max_steps": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Steps"
        },
        "wall_clock_s": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Wall Clock S"
        }
      },
      "title": "Limits",
      "type": "object"
    },
    "Observation": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "title": "Text",
          "type": "string"
        },
        "truncated": {
          "default": false,
          "title": "Truncated",
          "type": "boolean"
        },
        "error": {
          "default": false,
          "title": "Error",
          "type": "boolean"
        },
        "exit_code": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exit Code"
        }
      },
      "required": [
        "text"
      ],
      "title": "Observation",
      "type": "object"
    },
    "Outcome": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "default": "unknown",
          "title": "Label",
          "type": "string"
        },
        "passed": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Passed"
        },
        "partial_score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Partial Score"
        },
        "finish_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Finish Reason"
        }
      },
      "title": "Outcome",
      "type": "object"
    },
    "RawRef": {
      "additionalProperties": false,
      "properties": {
        "file": {
          "title": "File",
          "type": "string"
        },
        "line": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line"
        }
      },
      "required": [
        "file"
      ],
      "title": "RawRef",
      "type": "object"
    },
    "Step": {
      "additionalProperties": false,
      "properties": {
        "idx": {
          "minimum": 0,
          "title": "Idx",
          "type": "integer"
        },
        "ts": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ts"
        },
        "thought": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Thought"
        },
        "action": {
          "anyOf": [
            {
              "$ref": "#/$defs/Action"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "observation": {
          "anyOf": [
            {
              "$ref": "#/$defs/Observation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "tokens": {
          "anyOf": [
            {
              "$ref": "#/$defs/Tokens"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "raw_ref": {
          "$ref": "#/$defs/RawRef"
        },
        "phase": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Phase"
        },
        "phase_source": {
          "anyOf": [
            {
              "enum": [
                "rule",
                "llm"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Phase Source"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        }
      },
      "required": [
        "idx",
        "raw_ref"
      ],
      "title": "Step",
      "type": "object"
    },
    "Tokens": {
      "additionalProperties": false,
      "properties": {
        "in": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "In"
        },
        "out": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Out"
        }
      },
      "title": "Tokens",
      "type": "object"
    },
    "Usage": {
      "additionalProperties": false,
      "properties": {
        "input_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Tokens"
        },
        "output_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Tokens"
        },
        "wall_s": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Wall S"
        }
      },
      "title": "Usage",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "source_format": {
      "minLength": 1,
      "title": "Source Format",
      "type": "string"
    },
    "task_id": {
      "minLength": 1,
      "title": "Task Id",
      "type": "string"
    },
    "model": {
      "default": "unknown",
      "title": "Model",
      "type": "string"
    },
    "agent": {
      "default": "unknown",
      "title": "Agent",
      "type": "string"
    },
    "condition": {
      "default": "default",
      "title": "Condition",
      "type": "string"
    },
    "outcome": {
      "$ref": "#/$defs/Outcome"
    },
    "limits": {
      "anyOf": [
        {
          "$ref": "#/$defs/Limits"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "usage": {
      "anyOf": [
        {
          "$ref": "#/$defs/Usage"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "meta": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Meta",
      "type": "object"
    },
    "steps": {
      "items": {
        "$ref": "#/$defs/Step"
      },
      "title": "Steps",
      "type": "array"
    }
  },
  "required": [
    "id",
    "source_format",
    "task_id"
  ],
  "title": "Trajectory",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
